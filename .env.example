# ---- Session (REQUIRED, >= 32 chars random) ----
SESSION_SECRET=
# ---- Microsoft Entra ID (REQUIRED for real sign-in) ----
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Public origin of this app; redirect URI registered in Entra: {APP_URL}/api/auth/callback
APP_URL=http://localhost:3000
# ---- Local development only: enables the clearly-labelled demo sign-in. NEVER set in production. ----
DEMO_AUTH=false
# ---- AI provider (server side only) ----
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# ---- Database (PostgreSQL 13+/Supabase). Migrations in /db/migrations run automatically on start. ----
DATABASE_URL=
# Set true for hosted databases that require TLS
DATABASE_SSL=false
